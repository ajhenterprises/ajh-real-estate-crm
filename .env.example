# Copy to .env and fill in real values. .env is git-ignored.

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/ajh_real_estate_crm?schema=public"

# Auth.js session/JWT signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# --- Document storage -------------------------------------------------------
#
# DOCUMENT_STORAGE_DRIVER selects the backend (src/lib/storage/index.ts):
# unset or "local" uses the filesystem adapter below; "s3" uses the
# S3-compatible object-storage adapter further down. Only one driver's
# variables need to be set, matching whichever driver you choose.
#
# Local ("local", the default — development and test only):
# writes/reads files on local disk. Do NOT use this driver in production on
# Vercel (or any other serverless/ephemeral host) — Vercel's filesystem is
# read-only outside /tmp, and /tmp itself does not persist across function
# invocations or deployments. Any document uploaded through this driver on
# Vercel would be silently lost. It exists for local development and the
# test suite, where a real persistent disk is available.
DOCUMENT_STORAGE_PATH=".data/documents"

# S3-compatible ("s3" — required in production): works with any
# S3-compatible provider (Cloudflare R2, AWS S3, Backblaze B2, MinIO, ...).
# Nothing here is vendor-specific — switching providers is only ever an
# environment-variable change, never a code change (src/lib/storage/s3.ts).
# DOCUMENT_STORAGE_DRIVER="s3"
# S3_BUCKET="ajh-real-estate-crm-documents"                # required
# S3_ACCESS_KEY_ID="a9a1a798d60f2f11862afcc96235cf8f"         # required
# S3_SECRET_ACCESS_KEY="6c9b4604d9e8fc9bc00f213434428d60eb4e127e5521f803fad90b51e803b7d8"     # required
# S3_REGION="auto"            # optional; "auto" works for R2, use a real AWS region for S3
# S3_ENDPOINT="https://dd3ba7824dd91cf1120d67efe127cf44.r2.cloudflarestorage.com"              # required for R2/MinIO/most non-AWS providers; omit entirely for real AWS S3
# S3_FORCE_PATH_STYLE="false" # optional; some S3-compatible providers (e.g. MinIO) need "true"

# Optional: a dedicated database for DB-backed integration tests
# (src/test/db.ts). Must be a different database than DATABASE_URL above,
# with "test" in its name — the harness refuses to run otherwise. Tests that
# need it skip gracefully when this is unset. See src/test/db.ts for
# one-time setup instructions. Never point this at a production database.
# Development/test only — never set in a production environment.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/ajh_real_estate_crm_test?schema=public"
