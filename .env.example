# Copy to .env and fill in real values. .env is git-ignored.

# PostgreSQL connection string. The application (src/lib/db.ts) always
# connects with this one — in production, this should be your provider's
# *pooled* connection string (e.g. Supabase's Supavisor pooler on port 6543,
# or Neon's "-pooler" host), since serverless functions open many short-lived
# connections.
DATABASE_URL="postgresql://user:password@localhost:5432/ajh_real_estate_crm?schema=public"

# Direct (non-pooled) connection string, used only by the Prisma CLI for
# migrations (prisma7.config.ts) — never by the running application. Required
# in production whenever DATABASE_URL points at a connection pooler: Prisma's
# migration engine needs session-level state (advisory locks, a persistent
# DDL session) that a transaction-mode pooler like PgBouncer/Supavisor can
# drop mid-migration. Use your provider's direct/session connection string
# (e.g. Supabase's "Direct connection" on port 5432, or Neon's non "-pooler"
# host). Optional locally — falls back to DATABASE_URL when unset, since a
# local Postgres instance has no pooler in front of it.
# DIRECT_URL=""

# Auth.js session/JWT signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Temporary first-admin bootstrap (src/lib/auth/setup.ts, /setup page).
# Unset (the default) disables the /setup page entirely. Set it only long
# enough to create the first ADMIN user through the browser when there is no
# other way to reach the database (e.g. no terminal access to run
# `npm run db:seed`), then remove it again — see the /setup page's own
# instructions for the full flow. Must be at least 16 characters. Generate
# with: openssl rand -base64 32
# ADMIN_SETUP_SECRET=""

# --- Document storage -------------------------------------------------------
#
# DOCUMENT_STORAGE_DRIVER selects the backend (src/lib/storage/index.ts):
# unset or "local" uses the filesystem adapter below; "s3" uses the
# S3-compatible object-storage adapter further down. Only one driver's
# variables need to be set, matching whichever driver you choose.
#
# Local ("local", the default — development and test only):
# writes/reads files on local disk. Do NOT use this driver in production on
# Vercel (or any other serverless/ephemeral host) — Vercel's filesystem is
# read-only outside /tmp, and /tmp itself does not persist across function
# invocations or deployments. Any document uploaded through this driver on
# Vercel would be silently lost. It exists for local development and the
# test suite, where a real persistent disk is available.
DOCUMENT_STORAGE_PATH=".data/documents"

# S3-compatible ("s3" — required in production): works with any
# S3-compatible provider (Cloudflare R2, AWS S3, Backblaze B2, MinIO,
# Supabase Storage, ...). Nothing here is vendor-specific — switching
# providers is only ever an environment-variable change, never a code change
# (src/lib/storage/s3.ts). Supabase Storage exposes an S3-compatible API
# (Project Settings -> Storage -> S3 Connection in the Supabase dashboard),
# so pointing this driver at Supabase needs no new adapter — only new values
# below: S3_ENDPOINT is the "S3 Connection" endpoint shown there,
# S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY come from an S3 access key you
# create on that same page, S3_REGION is the region shown alongside it
# (not "auto"), and S3_FORCE_PATH_STYLE should be "true".
# DOCUMENT_STORAGE_DRIVER="s3"
# S3_BUCKET=""                # required
# S3_ACCESS_KEY_ID=""         # required
# S3_SECRET_ACCESS_KEY=""     # required
# S3_REGION="auto"            # optional; "auto" works for R2, use the real region for S3/Supabase
# S3_ENDPOINT=""              # required for R2/MinIO/Supabase/most non-AWS providers; omit entirely for real AWS S3
# S3_FORCE_PATH_STYLE="false" # optional; some S3-compatible providers (e.g. MinIO, Supabase Storage) need "true"

# --- Integrations ------------------------------------------------------------
#
# Encryption key for third-party integration credentials (API keys, OAuth
# tokens) stored on Integration.encryptedCredentials — see
# src/lib/integrations/credentials.ts. Not used by anything yet: this
# phase builds the integration foundation only, with no real Follow Up
# Boss/Bullseye/BoldTrail connection, so nothing writes a real credential
# here. Required once a real provider connection is implemented. Generate
# with: openssl rand -base64 32 (same convention as AUTH_SECRET above —
# must decode to exactly 32 bytes).
# INTEGRATION_CREDENTIALS_KEY=""

# --- Zillow lead email ingestion ---------------------------------------------
#
# Turns a forwarded Zillow lead-notification email into a Contact
# (contactType LEAD, source ZILLOW) — see src/app/api/leads/zillow-email/route.ts
# and src/lib/leads/zillow-email.ts. Delivery path: Zillow lead emails ->
# forwarded (or CC'd) to a dedicated address -> a Postmark Inbound Stream on
# that address -> Postmark POSTs the parsed email as JSON to
# https://<ZILLOW_LEAD_INBOX_USER>:<ZILLOW_LEAD_INBOX_PASSWORD>@<your-domain>/api/leads/zillow-email
# (set that full URL, credentials included, as the Inbound Stream's webhook
# URL in Postmark's dashboard — that's how Postmark authenticates to us,
# there's nothing else to configure on our side). Unset (the default)
# disables the route entirely (every request gets 401/503).
#
# HTTP Basic Auth credentials this route checks the Postmark webhook
# request against. Generate a password with: openssl rand -base64 24
# ZILLOW_LEAD_INBOX_USER="postmark"
# ZILLOW_LEAD_INBOX_PASSWORD=""
#
# Which CRM user owns Contacts created this way — must match a real user's
# login email.
# ZILLOW_LEAD_OWNER_EMAIL=""

# Optional: a dedicated database for DB-backed integration tests
# (src/test/db.ts). Must be a different database than DATABASE_URL above,
# with "test" in its name — the harness refuses to run otherwise. Tests that
# need it skip gracefully when this is unset. See src/test/db.ts for
# one-time setup instructions. Never point this at a production database.
# Development/test only — never set in a production environment.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/ajh_real_estate_crm_test?schema=public"
