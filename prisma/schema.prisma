// AJH Real Estate CRM — database schema
// learn more about Prisma schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

enum UserRole {
  AGENT
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(AGENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contacts                     Contact[]
  clients                      Client[]
  transactions                 Transaction[]
  tasks                        Task[]
  documents                    Document[]
  documentsDeletionInitiated   Document[]            @relation("DocumentDeletionInitiator")
  integrations                 Integration[]
  externalSyncLinks            ExternalSyncLink[]
  contractInformationOwned     ContractInformation[] @relation("ContractInformationOwner")
  contractInformationConfirmed ContractInformation[] @relation("ContractInformationConfirmedBy")
  expenses                     Expense[]
  mileageRecords               MileageRecord[]
  expenseCategories            ExpenseCategory[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Contacts — any person, regardless of source
// ---------------------------------------------------------------------------

// Where a contact originated. Kept open-ended so future lead sources
// (BoldTrail, Follow Up Boss, Bullseye, Facebook, other IDX/lead vendors, ...)
// can be added without redesigning Contact — a new value here plus a new
// ExternalProvider value is the entire schema change a new source needs.
enum ContactSource {
  MANUAL
  BOLDTRAIL
  FOLLOW_UP_BOSS
  BULLSEYE
  WEBSITE
  FACEBOOK
  ZILLOW
  REALTOR_COM
  REFERRAL
  OTHER
}

// A general categorization tag for the contact. Independent of whether a
// Client record exists for them — a contact can be tagged CLIENT before or
// after the operational Client relationship is created.
enum ContactType {
  LEAD
  CLIENT
  PAST_CLIENT
  VENDOR
  OTHER
}

model Contact {
  id              String        @id @default(cuid())
  firstName       String
  lastName        String
  preferredName   String?
  email           String?
  phone           String?
  secondaryPhone  String?
  address         String?
  city            String?
  state           String?
  zip             String?
  contactType     ContactType   @default(LEAD)
  source          ContactSource @default(MANUAL)
  // Identifier of this record in the source system (e.g. the BoldTrail or
  // Follow Up Boss contact ID). Lets future sync jobs match records instead
  // of creating duplicates. Null for contacts entered manually.
  sourceContactId String?
  notes           String?

  // Explicit, agent-entered "follow up with this person on this date."
  // Never inferred, never defaulted — null means no follow-up is scheduled,
  // not "overdue." See src/lib/status.ts's deriveFollowUpStatus for the
  // overdue/today/upcoming rule this drives.
  nextFollowUpDate DateTime?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  client         Client?
  tasks          Task[]
  documents      Document[]
  activities     ContactActivity[]
  expenses       Expense[]
  mileageRecords MileageRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([email])
  @@index([phone])
  @@index([source, sourceContactId])
  @@index([nextFollowUpDate])
  @@map("contacts")
}

// A contact's activity timeline. Manual actions (a note, a status change)
// and integration-generated events (a new lead synced in, a Facebook form
// submission) both land here through the same shape, so the future
// contact detail page never needs separate manual/integration feeds.
enum ContactActivityType {
  CREATED
  NOTE_ADDED
  STATUS_CHANGED
  SYNCED
  OTHER
  // Phase 7: agent-logged interaction types. Only these five (plus the
  // pre-existing NOTE_ADDED, reused rather than duplicated) count as a
  // personal touchpoint for "last contacted" — see
  // src/lib/contacts/activity.ts's CONTACT_TOUCHPOINT_ACTIVITY_TYPES.
  // CREATED/STATUS_CHANGED/SYNCED/OTHER are system-generated and never do.
  CALL
  EMAIL
  TEXT
  SHOWING
}

model ContactActivity {
  id              String              @id @default(cuid())
  type            ContactActivityType
  description     String
  // Same vocabulary as Contact.source — "manual" for agent-entered
  // activity, or the provider that generated it.
  source          ContactSource       @default(MANUAL)
  // The originating system's id for the event that produced this entry
  // (e.g. a webhook delivery or lead-event id). Lets a future sync job
  // dedupe/replay deliveries safely; null for manual activity.
  externalEventId String?
  metadata        Json?

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([source, externalEventId])
  @@map("contact_activities")
}

// ---------------------------------------------------------------------------
// Clients — a contact that has an active/past business relationship
// ---------------------------------------------------------------------------

enum ClientStatus {
  ACTIVE
  INACTIVE
  PAST
}

enum ClientType {
  BUYER
  SELLER
  BUYER_AND_SELLER
  OTHER
}

model Client {
  id     String       @id @default(cuid())
  status ClientStatus @default(ACTIVE)
  type   ClientType
  notes  String?

  contactId String  @unique
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // Denormalized from contact.ownerId so authorization checks and list
  // queries never need to join through Contact.
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  transactions   Transaction[]
  tasks          Task[]
  documents      Document[]
  expenses       Expense[]
  mileageRecords MileageRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@map("clients")
}

// ---------------------------------------------------------------------------
// Transactions — the heart of the application
// ---------------------------------------------------------------------------

enum TransactionType {
  BUYER
  SELLER
  OTHER
}

enum TransactionStatus {
  PROSPECT
  ACTIVE
  UNDER_CONTRACT
  PENDING
  CLOSED
  CANCELLED
}

model Transaction {
  id     String            @id @default(cuid())
  type   TransactionType
  status TransactionStatus @default(PROSPECT)

  propertyAddress String?
  propertyCity    String?
  propertyState   String?
  propertyZip     String?
  mlsNumber       String?

  purchasePrice Decimal? @db.Decimal(12, 2)
  listingPrice  Decimal? @db.Decimal(12, 2)

  contractEffectiveDate DateTime?
  expectedClosingDate   DateTime?
  actualClosingDate     DateTime?

  notes String?

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Denormalized from client.ownerId for authorization/list queries.
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  events              TransactionEvent[]
  tasks               Task[]
  documents           Document[]
  contractInformation ContractInformation[]
  expenses            Expense[]
  mileageRecords      MileageRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([clientId])
  @@index([status])
  @@index([expectedClosingDate])
  @@map("transactions")
}

// ---------------------------------------------------------------------------
// Transaction events / deadlines — flexible, not fixed columns
// ---------------------------------------------------------------------------

enum TransactionEventType {
  CONTRACT_EFFECTIVE
  EARNEST_MONEY_DUE
  INSPECTION_PERIOD_START
  INSPECTION_PERIOD_END
  FINANCING_DEADLINE
  APPRAISAL_DEADLINE
  TITLE_DEADLINE
  CLOSING_DATE
  FINAL_WALKTHROUGH
  POSSESSION_DATE
  OTHER
}

enum TransactionEventStatus {
  PENDING
  COMPLETED
  MISSED
  WAIVED
}

model TransactionEvent {
  id          String                 @id @default(cuid())
  eventType   TransactionEventType
  title       String
  description String?
  date        DateTime
  status      TransactionEventStatus @default(PENDING)
  // Where this date came from — "manual" (agent-added via Important Dates)
  // or "contract_information" (produced by confirming a ContractInformation
  // record). Kept as a free string, not an enum, exactly so a later phase
  // (e.g. OCR-assisted extraction) can add its own source label without a
  // schema change.
  source      String                 @default("manual")
  notes       String?

  // Calculation transparency (Phase 5). A date entered directly on a
  // ContractInformation record (contract effective, closing) is not
  // "calculated" — isCalculated is only true for a date derived from a
  // period rule (effective date + N days). calculatedDate preserves what
  // the rule produced even after a user override, so the original basis is
  // never lost. overrideNote is free text the agent can use to explain why
  // they changed it (e.g. a specific contract clause).
  isCalculated     Boolean   @default(false)
  calculationBasis String?
  calculatedDate   DateTime?
  isOverridden     Boolean   @default(false)
  overrideNote     String?

  // The ContractInformation record that produced/last updated this event,
  // if any. Nullable — manual events have none. Paired with the unique
  // constraint below: re-confirming the same ContractInformation record
  // updates its existing events in place instead of duplicating them.
  contractInformationId String?
  contractInformation   ContractInformation? @relation(fields: [contractInformationId], references: [id], onDelete: SetNull)

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  // The task generated from this event, if any (Phase 6). Back-relation
  // only — Task.transactionEventId is the owning, unique side.
  task Task?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractInformationId, eventType])
  @@index([transactionId])
  @@index([date])
  @@index([eventType])
  @@index([contractInformationId])
  @@map("transaction_events")
}

// ---------------------------------------------------------------------------
// Tasks — not transaction-only; may attach to a contact, client, transaction,
// or stand alone as a general CRM task.
// ---------------------------------------------------------------------------

enum TaskStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Where a task came from. FUTURE_CONTRACT is reserved for the future
// contract-extraction phase — nothing creates tasks with that source yet;
// the value exists now so that phase doesn't need a Task schema change.
enum TaskSource {
  MANUAL
  TRANSACTION_TEMPLATE
  FUTURE_CONTRACT
  OTHER
}

model Task {
  id            String       @id @default(cuid())
  title         String
  description   String?
  status        TaskStatus   @default(PENDING)
  priority      TaskPriority @default(NORMAL)
  dueDate       DateTime?
  completedDate DateTime?
  source        TaskSource   @default(MANUAL)
  // Denormalized from the generating TaskTemplate's category (e.g. "Under
  // Contract", "Inspection") so the transaction checklist can group tasks
  // without a join, and grouping survives even if the template is later
  // edited or deleted. Null for manual, non-checklist tasks.
  category      String?

  assignedUserId String
  assignedUser   User   @relation(fields: [assignedUserId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  // The template this task was generated from, if any. Nullable and
  // SetNull-on-delete: a template can be retired without erasing the
  // history of tasks it already produced. Paired with the unique
  // constraint below, this is the duplicate-protection mechanism for
  // checklist generation — Postgres allows unlimited rows with a NULL
  // templateId (manual tasks), but at most one row per
  // (transactionId, templateId) pair once both are set.
  templateId String?
  template   TaskTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // The TransactionEvent this task was generated from, if any (Phase 6:
  // contract-derived tasks, source FUTURE_CONTRACT). Unique + nullable/
  // SetNull, same pattern as templateId above: at most one task per event,
  // but an event can be deleted without deleting the task it produced.
  transactionEventId String?           @unique
  transactionEvent   TransactionEvent? @relation(fields: [transactionEventId], references: [id], onDelete: SetNull)

  // True once an agent has manually changed this task's due date away from
  // what contract-derived reconciliation last set it to. Only a due-date
  // change sets this — editing title/priority/notes/status never does.
  // While true, re-confirming the linked contract never overwrites the due
  // date; see reconcileContractDerivedTask in src/lib/contracts/task-sync.ts.
  isOverridden Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([transactionId, templateId])
  @@index([assignedUserId])
  @@index([status])
  @@index([dueDate])
  @@index([contactId])
  @@index([clientId])
  @@index([transactionId])
  @@index([templateId])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Task templates — the configurable checklist foundation. Rows here are
// shared reference/configuration data for this CRM instance (like the
// design tokens), not per-user business data, so there is no ownerId.
// Nothing hard-codes a checklist into a page: transaction creation reads
// the active templates for the transaction's type and generates real Task
// rows from them (see src/lib/tasks/checklist.ts).
// ---------------------------------------------------------------------------

// How a template's relative due date is anchored, when it has one. Only
// two anchors exist because only two dates are ever known at the moment a
// transaction (and its checklist) is created — the creation instant itself
// and whatever expected closing date was entered on the same form.
// Deriving a due date from a specific contract-confirmed deadline
// (inspection period, financing, ...) is future-phase work once
// TransactionEvents carry agent-confirmed dates.
enum TaskTemplateDueDateAnchor {
  TRANSACTION_CREATED
  EXPECTED_CLOSING_DATE
}

model TaskTemplate {
  id  String @id @default(cuid())
  // Stable identifier independent of the database id, so seeding is a
  // plain upsert keyed on something meaningful — reordering or rewording
  // a title never orphans the row or risks a duplicate insert.
  key String @unique

  transactionType TransactionType
  // Free-form grouping label for the checklist UI (e.g. "Under Contract",
  // "Inspection", "Closing"). Not an enum: buyer and seller checklists use
  // slightly different category names, and new categories shouldn't need
  // a migration.
  category        String
  title           String
  description     String?
  priority        TaskPriority    @default(NORMAL)

  // Relative due-date rule. Both null (the default for this phase's seed
  // data — see the phase notes) means "no due date": nothing here invents
  // a legal deadline. When set, dueDateOffsetDays is added to the anchor
  // date; if the anchor is EXPECTED_CLOSING_DATE and the transaction has
  // none, the generated task simply gets no due date rather than a guess.
  dueDateOffsetDays Int?
  dueDateAnchor     TaskTemplateDueDateAnchor?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionType, isActive, sortOrder])
  @@map("task_templates")
}

// ---------------------------------------------------------------------------
// Documents — private storage; no OCR/AI parsing in this phase.
// ---------------------------------------------------------------------------

enum DocumentType {
  CONTRACT
  DISCLOSURE
  ADDENDUM
  INSPECTION_REPORT
  APPRAISAL
  TITLE_DOCUMENT
  CLOSING_STATEMENT
  // Tax & Expense tracking: a receipt/supporting document attached to an
  // Expense via Document.expenseId.
  RECEIPT
  OTHER
}

enum DocumentStatus {
  UPLOADED
  REVIEWED
  ARCHIVED
  // Soft-deleted: an authorized user initiated deletion. The physical file
  // is untouched in storage; only scripts/cleanup-expired-documents.ts
  // (see src/lib/documents/mutations.ts's cleanupExpiredDocuments), run on
  // an external schedule, ever removes it — and only after the 45-day
  // retention window elapses and the deletion-protection gate still
  // passes at that moment. restoreDocument moves a document straight back
  // to UPLOADED; there is no distinct "restored" status.
  PENDING_DELETION
}

// Document deletion/retention lifecycle: src/lib/documents/mutations.ts is
// the only application code path that intentionally removes a Document.
// Deletion is two-phase, not immediate:
//   1. deleteDocument (soft delete) — an authorized user "deletes" a
//      document: after checkDocumentDeletionProtection passes, the row
//      moves to PENDING_DELETION with deletionInitiatedAt/
//      deletionInitiatedByUserId recorded. Storage is never touched here.
//   2. cleanupExpiredDocuments (hard delete) — run by
//      scripts/cleanup-expired-documents.ts on an external schedule (no
//      scheduler is configured by this codebase — see that script's own
//      comment and the README's Document Storage section), permanently
//      removes documents that have been PENDING_DELETION for at least 45
//      days AND still pass checkDocumentDeletionProtection when re-checked
//      at that moment — not merely at the time deletion was initiated.
//      Only then: physical file deleted first (ENOENT tolerated, any
//      other storage error aborts that document without touching its
//      row), then the row itself.
// restoreDocument reverses step 1 at any point before step 2 runs: status
// back to UPLOADED, the two deletion-tracking fields cleared, storage
// never touched — always safe to call even if nothing is pending.
//
// checkDocumentDeletionProtection (src/lib/documents/mutations.ts) is the
// single, centralized gate both phases call, immediately before any
// state-changing action. Today it has exactly one rule (the
// contractInformation relation below). This is deliberately the place a
// future document-carrying feature's own retention rule would be added
// (e.g. a not-yet-built tax/expense record's receipts needing to survive
// under different rules than an ordinary project document, or a future
// "is this a protected brand asset" flag, if one is ever added) — one
// more existence/flag check in that same function, nothing else to
// restructure. No such rule exists yet because no such feature exists yet.
//
// The onDelete: Cascade relations below are a separate, currently-unused
// path: if a User/Transaction/Client/Contact row were ever deleted — no
// application code does this today, only direct database administration —
// Postgres cascades the Document rows away at the DB level, with no
// opportunity for cleanupExpiredDocuments' file-cleanup logic to run.
// That leaves an orphaned file with no DB trace. This is a known, accepted
// limitation, not silently unaddressed: scripts/find-orphaned-documents.ts
// is a manually-invoked, local-filesystem-only reconciliation tool for
// exactly this case (see README's Document Storage section for why it
// doesn't yet cover R2-stored files) — it is never run automatically, and
// this change doesn't extend it to R2.
//
// Storage reuse for future document-carrying features: nothing about
// storage is specific to contacts/clients/transactions — `storagePath` is
// an opaque key, and src/lib/storage's StorageAdapter (local disk in dev,
// any S3-compatible bucket, e.g. Cloudflare R2, in production) has no
// knowledge of what owns a document. A future record type (e.g. an
// expense/tax record, not built yet) reuses the same storage layer and R2
// bucket exactly the way contactId/clientId/transactionId already do:
// one more nullable FK column here (e.g. expenseRecordId), a new key
// prefix (e.g. "expenses/{id}/{uuid}.ext"), and one more clause in
// deleteDocument's ownership OR — no second storage system, no schema
// redesign. Not built now because that future model doesn't exist yet.
model Document {
  id           String         @id @default(cuid())
  filename     String
  documentType DocumentType   @default(OTHER)
  description  String?
  // Opaque reference into the storage backend (local path or object-storage
  // key). The storage backend itself is an abstraction — see src/lib/storage.
  // Never exposed to the client directly; documents are only ever served
  // through the authenticated /api/documents/[id] route.
  storagePath  String
  fileSize     Int
  mimeType     String
  status       DocumentStatus @default(UPLOADED)
  // Free-form metadata bag (page count, ...) so the schema doesn't need to
  // grow a column per storage/detail concern.
  metadata     Json?

  uploadedByUserId String
  uploadedByUser   User     @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  uploadedAt       DateTime @default(now())

  // Soft-delete tracking (see the model-level comment above). Both null
  // whenever status is not PENDING_DELETION — restoreDocument clears them
  // back to null rather than leaving a stale prior value around.
  deletionInitiatedAt       DateTime?
  deletionInitiatedByUserId String?
  deletionInitiatedByUser   User?     @relation("DocumentDeletionInitiator", fields: [deletionInitiatedByUserId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  // Tax & Expense tracking: a receipt/supporting document attached to an
  // Expense. Deliberately NOT onDelete: Cascade like contact/client/
  // transaction above — an Expense is a plain record with no storage
  // lifecycle of its own, and deleting one must never delete its receipt's
  // physical file (see checkDocumentDeletionProtection below and
  // src/lib/tax-expenses/mutations.ts's deleteExpense). SetNull means
  // deleting an Expense row un-links its receipts — they survive as
  // ordinary, no-longer-protected-by-this-rule documents; the document
  // lifecycle (deleteDocument/cleanupExpiredDocuments) remains the only
  // path that ever touches the R2 object itself.
  expenseId String?
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  // A CONTRACT-type document may have exactly one structured
  // ContractInformation record built from it. Restrict (not Cascade orphan
  // deletion elsewhere handles): a document with contract information
  // behind it can't be deleted out from under it. deleteDocument checks
  // for this relation itself, before touching storage, so the file is
  // never destroyed only for this constraint to then block the row
  // delete. This was the model for wiring in the Tax & Expense receipt
  // protection above: checkDocumentDeletionProtection
  // (src/lib/documents/mutations.ts) now checks expenseId directly (no
  // extra query needed — it's a plain scalar on this same row) alongside
  // the ContractInformation existence check, both before storage.delete()
  // in deleteDocument and re-checked fresh in cleanupExpiredDocuments
  // immediately before the physical delete. No tax-specific retention
  // *period* is implemented here — only the protection relationship
  // itself, per this phase's explicit scope.
  contractInformation ContractInformation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionId])
  @@index([clientId])
  @@index([contactId])
  @@index([expenseId])
  @@index([uploadedByUserId])
  // Drives cleanupExpiredDocuments' eligibility query (status =
  // PENDING_DELETION AND deletionInitiatedAt <= cutoff).
  @@index([status, deletionInitiatedAt])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Contract information — structured, user-entered/confirmed data from a
// signed contract document. Deliberately separate from Transaction's own
// purchasePrice/contractEffectiveDate/expectedClosingDate: those are the
// CRM's working fields (may be set before a contract exists, or drift from
// it during negotiation), while this table is specifically "what the signed
// contract says," with its own provenance. Nothing here is inferred or
// OCR'd — every field is what the agent typed in and confirmed.
//
// One row per contract Document (documentId is unique below), not one per
// Transaction: an original contract and a later amendment are different
// Documents, so they naturally get different ContractInformation rows.
// That is the whole amendment story this phase needs to support — no
// version-chain or "supersedes" modeling yet, just not structurally
// preventing it.
// ---------------------------------------------------------------------------

enum ContractPeriodDayType {
  CALENDAR
  BUSINESS
}

model ContractInformation {
  id String @id @default(cuid())

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  documentId String   @unique
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  // Denormalized from transaction.ownerId, same authorization-query pattern
  // as every other model here.
  ownerId String
  owner   User   @relation("ContractInformationOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Parties — free text. A contract can list multiple buyers/sellers, and a
  // full parties/signatories model is more than this phase needs.
  buyerNames  String?
  sellerNames String?

  // Property — left blank unless the contract's stated address differs from
  // the transaction's working property address; nothing here re-copies data
  // that already matches.
  propertyAddress String?
  propertyCity    String?
  propertyState   String?
  propertyZip     String?

  // Financial — the contract's own stated terms. Kept separate from
  // Transaction.purchasePrice specifically so the two can be compared
  // (a contract can be negotiated after the transaction record is created).
  purchasePrice      Decimal? @db.Decimal(12, 2)
  earnestMoneyAmount Decimal? @db.Decimal(12, 2)

  // Dates stated directly in the contract — not calculated.
  contractEffectiveDate DateTime?
  expectedClosingDate   DateTime?
  earnestMoneyDueDate   DateTime?

  // Contract periods. Every field is independently nullable and has no
  // default length — see calculateContractEvents in
  // src/lib/contracts/dates.ts, which refuses to invent a period the user
  // didn't enter. dayType is the user's own calendar/business-day call, not
  // an assumption: BUSINESS counts Monday–Friday only (no holiday
  // calendar), which is disclosed in the UI wherever a calculated date is
  // shown.
  inspectionPeriodDays    Int?
  inspectionPeriodDayType ContractPeriodDayType?
  financingPeriodDays     Int?
  financingPeriodDayType  ContractPeriodDayType?
  appraisalPeriodDays     Int?
  appraisalPeriodDayType  ContractPeriodDayType?
  titlePeriodDays         Int?
  titlePeriodDayType      ContractPeriodDayType?

  notes String?

  // Presence of confirmedAt is the source of truth for "confirmed" — no
  // separate status enum to keep in sync with it. Before confirmedAt is
  // set, this row is a draft: nothing it contains has produced a
  // TransactionEvent yet.
  confirmedAt       DateTime?
  confirmedByUserId String?
  confirmedByUser   User?     @relation("ContractInformationConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  // Events this record has generated/updated via confirmation. See
  // TransactionEvent.contractInformationId for the uniqueness rule that
  // makes re-confirming idempotent.
  events TransactionEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionId])
  @@index([ownerId])
  @@map("contract_information")
}

// ---------------------------------------------------------------------------
// Integration foundation — no provider-specific logic on core CRM models.
//
// CRM Contact/Transaction/Task/Document
//     ↓
// Integration (connection) + ExternalSyncLink (per-record mapping)
//     ↓
// (future) provider adapter — src/lib/integrations/provider-adapter.ts
//     ↓
// (future) Follow Up Boss / Bullseye / BoldTrail
//
// Nothing here calls, authenticates against, or knows the field names of
// any real provider. No BoldTrail/Follow Up Boss/Bullseye client code
// exists yet — see src/lib/integrations/provider-adapter.ts for the
// interface a future provider implements, and this section's own model
// comments for how each piece is meant to be used. If an Integration is
// disconnected (status flips to DISCONNECTED — the row is never deleted by
// a normal disconnect), every CRM record it ever touched (Contact,
// Transaction, Task, Document, Expense, ...) is completely unaffected;
// only ExternalSyncLink rows (the mapping) and this connection's own state
// are integration-specific.
//
// Four concepts:
//   Integration       — one connection per (owner, provider): is it
//                        connected, what it's configured to do, and how
//                        did its last sync go. Credentials, if any, live
//                        here encrypted (see encryptedCredentials below;
//                        never returned to a client component — see
//                        src/lib/integrations/credentials.ts).
//   ExternalSyncLink   — per-record traceability: which external record a
//                        local Contact/Transaction/Task was matched to,
//                        generalized across record types (not hard-coded
//                        to Contact) so future sync jobs can match instead
//                        of duplicating records, for any of the internal
//                        record types this foundation supports.
//   IntegrationEvent   — a small, append-only audit trail for connection-
//                        level lifecycle events (connected, disconnected,
//                        sync started/completed/failed). Mirrors
//                        ContactActivity's existing shape/spirit
//                        (type + message + metadata + createdAt) rather
//                        than inventing a new pattern.
//   WebhookEvent       — tracks an inbound webhook delivery and its
//                        processing state. The (provider, externalEventId)
//                        uniqueness is the idempotency mechanism: the same
//                        delivery, retried by the provider, can never be
//                        recorded (and therefore never processed) twice.
//                        No live HTTP route accepts real deliveries yet —
//                        see src/lib/integrations/webhooks.ts's comment
//                        for why that's deliberately out of scope until a
//                        real provider's payload shape is known.
// ---------------------------------------------------------------------------

enum ExternalProvider {
  BOLDTRAIL
  FOLLOW_UP_BOSS
  BULLSEYE
  WEBSITE
  FACEBOOK
  OTHER
}

// Per-record sync state on ExternalSyncLink. "Disconnected" is
// deliberately not a value here — that's the parent Integration's own
// state (IntegrationStatus.DISCONNECTED); a link's last known sync
// status doesn't change just because the connection is currently down.
enum SyncStatus {
  PENDING
  SYNCING
  SYNCED
  ERROR
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

// Which CRM entity an ExternalSyncLink maps to. No FK/relation to the
// underlying table is declared for internalRecordId — Prisma has no
// native polymorphic-association support, and a real FK per record type
// would mean three near-identical nullable columns (the exact "duplicate
// concepts" this foundation is meant to avoid). The tradeoff — no DB-level
// referential integrity on this one mapping table — is accepted
// deliberately; ownerId below still gets real authorization enforcement.
enum InternalRecordType {
  CONTACT
  TRANSACTION
  TASK
}

enum IntegrationEventType {
  CONNECTED
  DISCONNECTED
  SYNC_STARTED
  SYNC_COMPLETED
  SYNC_FAILED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

model Integration {
  id            String            @id @default(cuid())
  provider      ExternalProvider
  status        IntegrationStatus @default(DISCONNECTED)
  // User-facing label (e.g. "Follow Up Boss — Team A"). Null falls back to
  // the provider's own display label (EXTERNAL_PROVIDER_LABELS) in the UI.
  displayName   String?
  // Non-secret configuration only (sync frequency, field mappings — see
  // src/lib/integrations/field-mapping.ts's FieldMapping type for the
  // shape a future mapping config would take). Never credentials.
  settings      Json?
  lastSyncedAt  DateTime?
  lastSyncError String?

  // Encrypted (AES-256-GCM via src/lib/integrations/credentials.ts), never
  // plain text, never selected by any query that returns Integration data
  // to a Server/Client Component — see that file's own comment for the
  // full contract. Null until a real connection stores something here;
  // this phase never writes a real credential to it.
  encryptedCredentials String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  syncLinks     ExternalSyncLink[]
  events        IntegrationEvent[]
  webhookEvents WebhookEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, provider])
  @@map("integrations")
}

model ExternalSyncLink {
  id         String           @id @default(cuid())
  provider   ExternalProvider
  externalId String

  internalRecordType InternalRecordType
  internalRecordId   String

  lastSyncedAt DateTime?
  syncStatus   SyncStatus @default(PENDING)
  syncError    String?

  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  // Denormalized rather than derived by joining through whichever table
  // internalRecordType points at (Contact/Transaction/Task each have
  // their own ownerId) — same convention as Transaction.ownerId being
  // denormalized from Client.ownerId. This is what makes "never expose
  // one user's external IDs to another" a single, uniform filter instead
  // of a per-record-type conditional join.
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The exact duplicate this foundation must prevent: the same
  // integration mapping the same internal record to the same external
  // record more than once.
  @@unique([integrationId, internalRecordType, internalRecordId, externalId])
  @@index([internalRecordType, internalRecordId])
  @@index([ownerId])
  @@map("external_sync_links")
}

// Connection-level audit trail — NOT for webhook events (WebhookEvent's
// own processingStatus/receivedAt/processedAt already cover "received/
// processed/failed" without a second, duplicate record of the same fact).
model IntegrationEvent {
  id       String               @id @default(cuid())
  type     IntegrationEventType
  // Human-readable summary, never a secret (e.g. "Connected to Follow Up
  // Boss" / "Sync failed: rate limited"). metadata is structured detail
  // for the same reason — never credentials, never raw provider payloads
  // (WebhookEvent.payload is the place for that).
  message  String?
  metadata Json?

  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([integrationId, createdAt])
  @@map("integration_events")
}

model WebhookEvent {
  id       String           @id @default(cuid())
  provider ExternalProvider

  // Nullable: a delivery can arrive before it's matched to a specific
  // owner's connection (or fail to match at all) — see
  // src/lib/integrations/webhooks.ts. Any future feature that lists or
  // displays WebhookEvent rows MUST filter through integration.ownerId;
  // this table has no direct ownerId of its own because an unmatched
  // event legitimately has no owner yet.
  integrationId String?
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  // The provider's own event id for this delivery — the idempotency key
  // (see the unique constraint below). eventType is free text (e.g.
  // "contact.updated") since providers don't share a vocabulary; no
  // enum would stay meaningful across three different providers.
  externalEventId String
  eventType       String
  // Raw (or lightly parsed) event body. Never a place credentials belong
  // — a provider's webhook payload describing a CRM record isn't a
  // secret the way an OAuth token is, but this is still never logged in
  // full (see webhooks.ts) and never returned to a client component.
  payload         Json?

  processingStatus WebhookProcessingStatus @default(RECEIVED)
  receivedAt       DateTime                @default(now())
  processedAt      DateTime?
  errorMessage     String?
  retryCount       Int                     @default(0)

  // The idempotency guarantee this whole model exists for: the same
  // provider delivering the same external event id twice can only ever
  // occupy one row here.
  @@unique([provider, externalEventId])
  @@index([integrationId])
  @@index([processingStatus])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Tax & Expense tracking — record-keeping, not tax advice
// ---------------------------------------------------------------------------
//
// This section is a record-keeping/reporting tool only. Nothing here makes
// a legal or tax determination: deductibleStatus is a label the user (or
// their tax professional) sets, defaulting to NEEDS_REVIEW on every new
// expense — the system never infers or defaults it to DEDUCTIBLE, and
// businessUsePercent is never defaulted to 100 by the system either (see
// src/lib/tax-expenses/validation.ts). No tax rate, deduction amount, or
// mileage reimbursement rate is stored or calculated anywhere in this
// schema; MileageRecord tracks actual miles only.

enum PaymentMethod {
  BUSINESS_BANK_ACCOUNT
  BUSINESS_CREDIT_CARD
  PERSONAL_CARD
  CASH
  CHECK
  OTHER
}

enum DeductibilityStatus {
  NEEDS_REVIEW
  DEDUCTIBLE
  NOT_DEDUCTIBLE
}

// Reference data, not an enum like PaymentMethod/DeductibilityStatus above
// — the whole point is letting a user add their own category without a
// future migration (a fixed set of defaults is seeded by this table's own
// migration; see that migration's INSERT statements). ownerId null = a
// shared default every user sees; ownerId set = a custom category created
// by, and visible only to, that user.
model ExpenseCategory {
  id              String  @id @default(cuid())
  name            String
  isSystemDefault Boolean @default(false)

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  expenses Expense[]

  createdAt DateTime @default(now())

  @@unique([ownerId, name])
  @@index([ownerId])
  @@map("expense_categories")
}

model Expense {
  id String @id @default(cuid())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  expenseDate DateTime
  // Derived from expenseDate's UTC calendar year at write time (see
  // src/lib/tax-expenses/mutations.ts) — stored, not computed at query
  // time, so tax-year filtering/reporting stays a plain indexed equality
  // check. Same UTC-date-only convention as the rest of this schema (see
  // src/lib/format.ts).
  taxYear     Int

  // Money: Decimal, never Float — same convention as
  // Transaction.purchasePrice/ContractInformation's financial fields.
  amount Decimal @db.Decimal(12, 2)

  vendor String

  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  businessPurpose  String?
  paymentMethod    PaymentMethod       @default(OTHER)
  deductibleStatus DeductibilityStatus @default(NEEDS_REVIEW)

  // 0-100, validated in src/lib/tax-expenses/validation.ts. Null means "not
  // a mixed-use expense" — never defaulted to 100 by the system; only ever
  // set by explicit user entry (e.g. shared phone/internet/vehicle/home
  // office costs).
  businessUsePercent Int?

  notes String?

  // Optional associations — independently nullable, same pattern as
  // Document's contactId/clientId/transactionId. Neither an expense nor a
  // mileage record is ever forced to belong to a transaction: "CRM
  // subscription — $79" is exactly as valid as "Photography — 123 Main
  // Street — $175".
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // One or more receipts/supporting documents — see Document.expenseId's
  // own comment for the deletion-protection design this enables.
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, taxYear])
  @@index([ownerId, categoryId])
  @@index([transactionId])
  @@index([clientId])
  @@index([contactId])
  @@map("expenses")
}

model MileageRecord {
  id String @id @default(cuid())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  date    DateTime
  // Same derivation/storage rationale as Expense.taxYear above.
  taxYear Int

  startLocation   String
  destination     String
  businessPurpose String

  // Decimal, not Float, for the same reason financial amounts are —
  // avoids floating-point drift on a value that gets summed for reporting.
  // No mileage rate is stored anywhere here; this table tracks actual
  // miles only (see this section's top comment).
  miles Decimal @db.Decimal(8, 1)

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, taxYear])
  @@index([transactionId])
  @@index([clientId])
  @@index([contactId])
  @@map("mileage_records")
}

// ---------------------------------------------------------------------------
// Brand settings — CRM-wide, not per-user
// ---------------------------------------------------------------------------

// Singleton row (id is always the literal string "default", enforced only by
// convention in src/lib/settings/brand.ts — every read/write targets that
// one id). Branding is a property of the CRM/brokerage as a whole, not of
// any one signed-in user, so this deliberately has no ownerId, unlike every
// other model in this schema.
model BrandSettings {
  id              String   @id @default("default")
  companyName     String?
  logoStoragePath String?
  logoMimeType    String?
  primaryColor    String   @default("#1c3a5e")
  accentColor     String   @default("#2f6fed")
  updatedAt       DateTime @updatedAt

  @@map("brand_settings")
}
